# Kopieren nach /etc/modem-collector.env und mit chmod 600 schützen.
# Passwörter mit Sonderzeichen in einfache Anführungszeichen setzen: MODEM_PASS='a$b#c'
MODEM_HOST=http://192.168.100.1
MODEM_USER=admin
MODEM_PASS=HIER_PASSWORT

INFLUX_URL=http://localhost:8086
INFLUX_DB=modem
# Nur nötig, wenn in InfluxDB die Authentifizierung aktiv ist:
#INFLUX_USER=
#INFLUX_PASS=

# Abfrageintervall (s); die Statusseite des Modems braucht ca. 15 s
INTERVAL=60
# Eventlog-Intervall (s)
EVENT_INTERVAL=300
